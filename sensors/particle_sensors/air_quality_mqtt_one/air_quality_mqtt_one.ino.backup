void mqtt_receiver_callback(char* topic, byte* message, unsigned int length) {
  Serial.print("Message arrived on topic: ");
  Serial.print(topic);
  Serial.print(". Message: ");
  String messageTemp;
  
  for (int i = 0; i < length; i++) {
    Serial.print((char)message[i]);
    messageTemp += (char)message[i];
  }
  Serial.println();
  

  if(String(topic) == String("ha-newera/status")) {
      if(messageTemp == "online"){
          mqtt_home_assistant_discovery();
      }
  }
}

void setup() {
  Serial.begin(115200);
  setup_wifi();
  neo_pixel_one.clear(); 
  neo_pixel_two.clear(); 
  neo_pixel_three.clear(); 
  neo_pixel_four.clear(); 
  neo_pixel_five.clear(); 
   
  neo_pixel_one.show();  // update to the NeoPixel Led Strip
  neo_pixel_two.show();  // update to the NeoPixel Led Strip
  neo_pixel_three.show();  // update to the NeoPixel Led Strip
  neo_pixel_four.show();  // update to the NeoPixel Led Strip
  neo_pixel_five.show();  // update to the NeoPixel Led Strip
  
  client.setServer(mqtt_server, 1883);
  client.setCallback(mqtt_receiver_callback);
  client.setBufferSize(1024);

  // PIR Motion Sensor mode INPUT_PULLUP
  pinMode(PIR_PIN, INPUT);
  dht.begin();

  // LUX

  lightInit = analogRead(LUX_PIN);

  //Set math model to calculate the PPM concentration and the value of constants
  MQ135.setRegressionMethod(1); //_PPM =  a*ratio^b
  MQ135.setA(110.47); MQ135.setB(-2.862); // Configure the equation to to calculate C02 concentration
  
  /*
    Exponential regression:
  GAS      | a      | b
  CO       | 605.18 | -3.937  
  Alcohol  | 77.255 | -3.18 
  CO2      | 110.47 | -2.862
  Toluen   | 44.947 | -3.445
  NH4      | 102.2  | -2.473
  Aceton   | 34.668 | -3.369
  */
  
  MQ135.init(); 
  Serial.print("Calibrating mq135 please wait.");
  float calcR0 = 0;
  for(int i = 1; i<=10; i ++)
  {
    MQ135.update(); // Update data, the arduino will read the voltage from the analog pin
    calcR0 += MQ135.calibrate(RatioMQ135CleanAir);
    Serial.print(".");
  }
  MQ135.setR0(calcR0/10);
  Serial.println("  done!.");
  
  if(isinf(calcR0)) {Serial.println("Warning: Conection issue, R0 is infinite (Open circuit detected) please check your wiring and supply"); while(1);}
  if(calcR0 == 0){Serial.println("Warning: Conection issue found, R0 is zero (Analog pin shorts to ground) please check your wiring and supply"); while(1);}
  MQ135.serialDebug(true);


  Serial.println("\n\n----------------------------------------------");
  Serial.print("MODEL: ");
  Serial.println(g_deviceModel);
  Serial.print("DEVICE: ");
  Serial.println(g_deviceName);
  Serial.print("SW Rev: ");
  Serial.println(g_swVersion);
  Serial.println("----------------------------------------------");


  for (int pixel = 0; pixel < NUM_PIXELS; pixel++) {           
        neo_pixel_one.setPixelColor(pixel, neo_pixel_one.Color(200, 0, 0));  // it only takes effect if pixels.show() is called
        neo_pixel_two.setPixelColor(pixel, neo_pixel_two.Color(200, 200, 0));  // it only takes effect if pixels.show() is called
        neo_pixel_three.setPixelColor(pixel, neo_pixel_three.Color(200, 200, 233));  // it only takes effect if pixels.show() is called
        neo_pixel_four.setPixelColor(pixel, neo_pixel_four.Color(0, 0, 233));  // it only takes effect if pixels.show() is called
        neo_pixel_five.setPixelColor(pixel, neo_pixel_five.Color(0, 200, 0));  // it only takes effect if pixels.show() is called
      }
  neo_pixel_one.show();  
  neo_pixel_two.show();
  neo_pixel_three.show();
  neo_pixel_four.show();
  neo_pixel_five.show();
  delay(100);  
  

  sds.begin();
  Serial.println(sds.queryFirmwareVersion().toString()); // prints firmware version
  //Serial.println(sds.setActiveReportingMode().toString()); // ensures sensor is in 'active' reporting mode
  Serial.println(sds.setQueryReportingMode().toString()); // ensures sensor is in 'query' reporting mode
  //Serial.println(sds.setContinuousWorkingPeriod().toString()); // ensures 


  if(!initialized) {
      delay(100);
      initialized = true;
      //mqtt_home_assistant_discovery();     // Send Discovery Data
      Serial.println("INIT SYSTEM...");
  }
  //mqtt_home_assistant_discovery();
  Serial.println("Mqtt Light & Ux Discovery Sent");
  

}



void setup_wifi() {
  delay(10);
  int counter = 0;
  // We start by connecting to a WiFi network
  Serial.println();
  Serial.print("Connecting to ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  byte mac[6];
  WiFi.macAddress(mac);
  g_UniqueId =  String(mac[0],HEX) +String(mac[1],HEX) +String(mac[2],HEX) +String(mac[3],HEX) + String(mac[4],HEX) + String(mac[5],HEX);

  Serial.print("Unique ID: ");
  Serial.println(g_UniqueId);  

  while(WiFi.status() != WL_CONNECTED && counter++ < 8) {
      delay(1000);
      Serial.print(".");
  }
  Serial.println("");

  if(WiFi.status() == WL_CONNECTED) {
      Serial.println("WiFi connected");
      Serial.print("IP address: ");
      Serial.println(WiFi.localIP());
  } else {
      Serial.println("WiFi NOT connected!!!");
  }  
}

void get_mq_data(){
  for(int i = 0; i<3; i++)
  {
    switch (i)
    {
     case 1:
            MQ135.setA(110.47); MQ135.setB(-2.862); // Configure the equation to to calculate C02 concentration
            MQ135.update(); // Update data, the arduino will read the voltage from the analog pin
            CO2 = MQ135.readSensor(); // Sensor will read PPM concentration using the model, a and b values set previously or from the setup
            //CO2 = MQ135.ppmprint(1);
            //Serial.print("CO2 : ");
            Serial.println("CO2 : "+ String(CO2) + " PPM" );
            break;
     case 2:
            MQ135.setA(102.2); MQ135.setB(-2.473); // Configure the equation to to calculate NH4 concentration
            MQ135.update(); // Update data, the arduino will read the voltage from the analog pin
            NH4 = MQ135.readSensor(); // Sensor will read PPM concentration using the model, a and b values set previously or from the setup
            Serial.println("NH4 : " + String(NH4) + " PPM" );  
            //NH4 = MQ135.ppmprint(1);
            //Serial.print("NH4 : ");
            break;  
    }
  }
  
  
}

void reconnect() {
  // Loop until we're reconnected
  while (!client.connected() && (mqttCounterConn++ < 4)) {
    Serial.print("Attempting MQTT connection...");
    // Attempt to connect
    if (client.connect(g_deviceName.c_str())) {
      Serial.println("connected");
      // Subscribe
      client.subscribe("homeassistant/status");
      delay(100);
    } else {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      Serial.println(" try again in 5 seconds");
      // Wait 5 seconds before retrying
      delay(5000);
    }
  }
  mqttCounterConn = 0;
}

void mqtt_home_assistant_discovery() {
    String co2_discoveryTopic, pm25_discoveryTopic, lux_discoveryTopic, pm10_discoveryTopic;
    String nh4_discoveryTopic, temp_discoveryTopic, hum_discoveryTopic, pir_discoveryTopic;
    
    Serial.print("Mqtt Status Clinet: ");
    Serial.println(client.connected());
    while (!client.connected())
          reconnect();
    {
        Serial.println("SEND HOME ASSISTANT DISCOVERY!!!");
        StaticJsonDocument<1024> temp_payload, hum_payload, pir_payload, lux_payload, nh4_payload;
        StaticJsonDocument<1024> pm10_payload, pm25_payload, co2_payload;
        String temp_strPayload, nh4_strPayload, co2_strPayload, pir_strPayload, lux_strPayload, pm25_strPayload, pm10_strPayload, hum_strPayload;
        JsonObject device;
        JsonArray identifiers;

        // Temp
        temp_discoveryTopic = "ha-newera/sensor/" + g_deviceName + "_temp/config";
        
        temp_payload["name"] = g_deviceName + ".temp";
        temp_payload["uniq_id"] = g_UniqueId + "_temp";
        temp_payload["stat_t"] = mqttStatusTopic;
        temp_payload["dev_cla"] = "temperature";
        temp_payload["val_tpl"] = "{{ value_json.temp | round(1) | is_defined }}";
        temp_payload["unit_of_meas"] = "°C";
        device = temp_payload.createNestedObject("device");
        device["name"] = g_deviceName;
        device["model"] = g_deviceModel;
        device["sw_version"] = g_swVersion;
        device["manufacturer"] = g_manufacturer;
        identifiers = device.createNestedArray("identifiers");
        identifiers.add(g_UniqueId);

        serializeJsonPretty(temp_payload, Serial);
        Serial.println(" Sending Temp Discovery");
        serializeJson(temp_payload, temp_strPayload);

        client.publish(temp_discoveryTopic.c_str(), temp_strPayload.c_str());

        delay(2000);

        // HUM
        device.clear();
        identifiers.clear();

        hum_discoveryTopic = "ha-newera/sensor/"  + g_deviceName + "_hum/config";
        
        hum_payload["name"] = g_deviceName + ".hum";
        hum_payload["uniq_id"] = g_UniqueId + "_hum";
        hum_payload["stat_t"] = mqttStatusTopic;
        hum_payload["dev_cla"] = "humidity";
        hum_payload["val_tpl"] = "{{ value_json.hum | round(1) | is_defined }}";
        hum_payload["unit_of_meas"] = "%";
        device = hum_payload.createNestedObject("device");
        device["name"] = g_deviceName;
        device["model"] = g_deviceModel;
        device["sw_version"] = g_swVersion;
        device["manufacturer"] = g_manufacturer;
        identifiers = device.createNestedArray("identifiers");
        identifiers.add(g_UniqueId);

        serializeJsonPretty(hum_payload, Serial);
        Serial.println(" Sending Hum Discovery");
        serializeJson(hum_payload, hum_strPayload);

        client.publish(hum_discoveryTopic.c_str(), hum_strPayload.c_str());
        delay(2000);

        // PIR
        device.clear();
        identifiers.clear();

        pir_discoveryTopic = "ha-newera/binary_sensor/"  + g_deviceName + "_pir/config";

        pir_payload["name"] = g_deviceName + ".pir";
        pir_payload["uniq_id"] = g_UniqueId + "_pir";
        pir_payload["stat_t"] = mqttStatusTopic;
        pir_payload["val_tpl"] = "{{ value_json.pir }}";
        pir_payload["device_class"] = "motion";
        device = pir_payload.createNestedObject("device");
        device["name"] = g_deviceName;
        device["model"] = g_UniqueId;
        device["sw_version"] = g_swVersion;
        device["manufacturer"] = g_manufacturer;
        identifiers = device.createNestedArray("identifiers");
        identifiers.add(g_UniqueId);

        serializeJsonPretty(pir_payload, Serial);
        Serial.println(" Sending PIR Discovery");
        serializeJson(pir_payload, pir_strPayload);

        client.publish(pir_discoveryTopic.c_str(), pir_strPayload.c_str());
        delay(2000);

        // LUX
        device.clear();
        identifiers.clear();

        lux_discoveryTopic = "ha-newera/sensor/"  + g_deviceName + "_lux/config";
        
        lux_payload["name"] = g_deviceName + ".lux";
