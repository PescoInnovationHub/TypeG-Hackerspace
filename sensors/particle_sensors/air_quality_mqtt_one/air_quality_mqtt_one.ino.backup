// Fixed False Reading error
void dht_routine(){
    // Sensor readings may also be up to 2 seconds 'old' (its a very slow sensor)
    float cur_humidity = dht.readHumidity();
    // Read temperature as Celsius (the default)
    float cur_temperature = dht.readTemperature();

    // Check if any reads failed and exit early (to try again).
    if (isnan(cur_humidity) || isnan(cur_temperature) ) {
      Serial.println(F("Failed to read from DHT sensor!"));
      // BuGFIX
      dht.begin();
      return;
    }

    temperature = cur_temperature;
    humidity = cur_humidity;

    Serial.print(F("Humidity: "));
    Serial.print(humidity);
    Serial.print(F("%  Temperature: "));
    Serial.print(temperature);
    Serial.println(F("°C "));
}

void pm_routine(){
  //TODO Check readings error and re init sensor if needed
  // PM Sensor routine

  sds.wakeup();

  PmResult pm = sds.queryPm();
  //PmResult pm = sds.readPm();
  if (pm.isOk()) {
    pm_25 = pm.pm25;
    pm_10 = pm.pm10;
    Serial.println(pm.toString());
  } else {
    // notice that loop delay is set to 0.5s and some reads are not available
    Serial.print("Could not read values from sensor, reason: ");
    Serial.println(pm.statusToString());
  }
}

// Linear mapping of temperature to LED index FIXED
int map_val_to_led_index(float val, float val_min , float val_max, int led_min = 1, int led_max = 10) {
    // BUGFIX nan val? Prevent case scenario
    // BUGFIX  max val 
    if (val > val_max)
      val_max = val;
  
    if (val < val_min)
      val_min = val;

    float mappedValue = (val - val_min) / (val_max - val_min) * (led_max - led_min) + led_min;
    // Clamp the value to the LED range
    if (mappedValue < led_min) mappedValue = led_min;
    if (mappedValue > led_max) mappedValue = led_max;
    return int(mappedValue);
}

uint32_t set_color(int num_pix, bool temp = false, bool hum=false){
    if (num_pix < 3) {
      if (temp)
        return neo_pixel_one.Color(10,10,200);
      else if (hum)
        return neo_pixel_one.Color(200,50,50);
      else
        return neo_pixel_one.Color(50,200,50);
    }
    if (num_pix < 5) {
      if (temp)
        return neo_pixel_one.Color(50,50,200);
      else if (hum)
        return neo_pixel_one.Color(200,50,50);
      else
        //return neo_pixel_one.Color(50,200,50);
        return neo_pixel_one.Color(200,50,50);
    }
    else if (num_pix < 8) 
        return neo_pixel_one.Color(50,50,200);
    else {
      if (hum)
        return neo_pixel_one.Color(10,10,200);
      else
        return neo_pixel_one.Color(250,50,10);
    }
}

void set_ux(){

  neo_pixel_one.clear(); 
  neo_pixel_two.clear(); 
  neo_pixel_three.clear(); 
  neo_pixel_four.clear(); 
  neo_pixel_five.clear(); 
   
  neo_pixel_one.show();  // update to the NeoPixel Led Strip
  neo_pixel_two.show();  // update to the NeoPixel Led Strip
  neo_pixel_three.show();  // update to the NeoPixel Led Strip
  neo_pixel_four.show();  // update to the NeoPixel Led Strip
  neo_pixel_five.show();  // update to the NeoPixel Led Strip
  
  int num_pix;

  // Set NH4 UX - OK
  if (NH4 == 0)
    num_pix = 1;
  else {
    num_pix = map_val_to_led_index(NH4, MIN_NH4, MAX_NH4);

    Serial.print("hum Led: ");
    Serial.println(num_pix);
    for (int pixel = 0; pixel < num_pix; pixel++) {    
      neo_pixel_two.setPixelColor(pixel, set_color(num_pix));  // it only takes effect if pixels.show() is called
      neo_pixel_two.setBrightness(BRIGHTNESS);
    }
  }

  // Set temp UX
  if (temperature == 0)
    num_pix = 0;
  else {
    num_pix = map_val_to_led_index(temperature, MIN_TEMP, MAX_TEMP);
    Serial.print("Temp Led: ");
    Serial.println(num_pix);

    for (int pixel = 0; pixel < num_pix; pixel++) {    
      neo_pixel_five.setPixelColor(pixel, set_color(num_pix, true));  // it only takes effect if pixels.show() is called
      neo_pixel_five.setBrightness(BRIGHTNESS);
    }
  }


  // Set CO2 UX - Ok
  if (CO2 == 0)
    num_pix = 0;
  else {
    num_pix = map_val_to_led_index(CO2, MIN_CO2, MAX_CO2);
    Serial.print("pm CO2 Led: ");
    Serial.println(num_pix);
    for (int pixel = 0; pixel < num_pix; pixel++) {    
      neo_pixel_three.setPixelColor(pixel, set_color(num_pix));  // it only takes effect if pixels.show() is called
      neo_pixel_three.setBrightness(BRIGHTNESS);
    }
  }

  // Set PM10 UX - OK
  if (pm_10 == 0)
    num_pix = 0;
  else {
    num_pix = map_val_to_led_index(pm_10, MIN_PM10, MAX_PM10);
    Serial.print("pm 10 Led: ");
    Serial.println(num_pix);
    for (int pixel = 0; pixel < num_pix; pixel++) {    
      neo_pixel_one.setPixelColor(pixel, set_color(num_pix));  // it only takes effect if pixels.show() is called
      neo_pixel_one.setBrightness(BRIGHTNESS);
    }
  }


  // Set 2.5 UX - OK 
  if (pm_25 == 0)
    num_pix = 0;
  else {
    num_pix = map_val_to_led_index(pm_25, MIN_PM25, MAX_PM25);
    Serial.print("pm 2.5 Led: ");
    Serial.println(num_pix);
    for (int pixel = 0; pixel < num_pix; pixel++) {    
      neo_pixel_four.setPixelColor(pixel, set_color(num_pix));  // it only takes effect if pixels.show() is called
      neo_pixel_four.setBrightness(BRIGHTNESS);
    }
  }

  neo_pixel_one.show();  
  neo_pixel_two.show();
  neo_pixel_three.show();
  neo_pixel_four.show();
  neo_pixel_five.show();

  // mq135+dht22 left - five - four - one - three - two - PIR 
  delay(100);  
}

void loop() {
  if(WiFi.status() == WL_CONNECTED) {
      if(!client.connected())
          //reconnect();
        Serial.println("Skipping");
      else
          client.loop();
  }

  //Serial.println("Out of it");
  long now = millis();
  if (now - lastMsg > 5000) {
    lastMsg = now;


    loop_payload.clear();
    
    pirStatePrevious = pirStateCurrent; // store old state
    pirStateCurrent = digitalRead(PIR_PIN);   // read new state
    Serial.println(pirStateCurrent);
    
    if (pirStatePrevious == LOW && pirStateCurrent == HIGH) {   // pin state change: LOW -> HIGH
      Serial.println("Motion detected!");
      loop_payload["pir"] = "ON";
    }
    else if (pirStatePrevious == HIGH && pirStateCurrent == LOW) {   // pin state change: HIGH -> LOW
      Serial.println("Motion stopped!");
      loop_payload["pir"] = "OFF";
    }

    lightVal = analogRead(LUX_PIN);
    Serial.print("LUX : "); 
    Serial.println(lightVal); 
    loop_payload["lux"] = lightVal;


    //client.publish(btn_mqttStatusTopic.c_str(), "ON");
    //digitalWrite(LED_PIN, HIGH);

    // MQ sensor routine 
    get_mq_data();
    loop_payload["nh4_ppm"] = NH4;
    loop_payload["co2_ppm"] = CO2;

    // Temp & Hum routine
    dht_routine();
    loop_payload["temp"] = temperature;
    loop_payload["hum"] = humidity;

    //pm_routine();
    loop_payload["pm25_ppm"] = pm_25;
    loop_payload["pm10_ppm"] = pm_10;

    set_ux();


    loop_strPayload.clear();
    serializeJson(loop_payload, loop_strPayload);
    if(client.connected())
    {
        client.publish(mqttStatusTopic.c_str(), loop_strPayload.c_str()); 
        Serial.println("MQTT: Send Data!!!");
        Serial.println(" ");
        Serial.println(" ");
    }

  }


  unsigned long currentMillis = millis();

  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;
    
    Serial.println("IN");
    // Wake up the sensor and read values
    sds.wakeup();
    delay(1000); // Short delay to stabilize sensor after waking up

    PmResult pm = sds.queryPm();
    if (pm.isOk()) {

      pm_25 = pm.pm25;
      pm_10 = pm.pm10;
      Serial.println(pm.toString());
    } else {
      Serial.print("Could not read values from sensor, reason: ");
      Serial.println(pm.statusToString());
    }

    // Put the sensor to sleep
    WorkingStateResult state = sds.sleep();
    if (state.isWorking()) {
      Serial.println("Problem with sleeping the sensor.");
    } else {
      Serial.println("Sensor is sleeping");
    }
  }

}